<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- アイコン長押しのショートカット（res/xml/shortcuts.xml） -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- 共有をオンにしたときだけ、匿名の号車混雑報告を送り、みんなの集計を受け取る（プライバシーポリシー 2 章） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 位置情報（任意・オンにした人だけ）: アプリを開いた時と記録した時に近くの駅を調べる。裏では取らない（BACKGROUND は付けない）。
         位置は端末の中で駅を探すのに使うだけで、保存も送信もしない -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 位置情報の権限を付けると「GPS が必須」とみなされ、GPS のない端末（一部のタブレット等）が Google Play の対象外になる。
         位置情報は任意の機能なので、なくても入れられるようにする（1.12 で 6 機種が外れた警告への対応） -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- 通知プラグインが追加する正確アラーム権限は外す。Google Play はアラーム/カレンダーアプリ以外に認めず、通勤リマインドは数分ずれても困らない -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
