{
  // すいてるログ v2 の報告 API（docs/SPEC-v2.md）
  "name": "suiteru-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "d1_databases": [
    { "binding": "DB", "database_name": "suiteru-reports", "database_id": "bbdc25da-4276-4da3-a7a0-88ec962aee07" }
  ],
  // 同じ IP からの報告を 1 分あたり 120 件まで（ID を作り替えた大量投稿で無料枠を使い切られないように。IP は保存しない）
  // 携帯回線は多くの人が同じ IP を共有するので、朝のラッシュでも正規の報告が止まらない程度に緩くしている
  "ratelimits": [
    { "name": "POST_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
